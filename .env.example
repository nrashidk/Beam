# Environment Configuration Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ==================== ENVIRONMENT ====================
ENV=development
PRODUCTION_MODE=false

# ==================== SECURITY ====================
# CRITICAL: Generate a secure random secret key for JWT tokens
# Use: openssl rand -hex 32
# In production, this MUST be set and should be 32+ characters
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# CORS allowed origins (comma-separated)
# Development default includes localhost variants
# Production: Set to your actual domain(s)
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:3000,http://127.0.0.1:5000,http://127.0.0.1:3000

# ==================== DATABASE ====================
# SQLite (development)
DATABASE_URL=sqlite:///./.dev.db

# PostgreSQL (production example)
# DATABASE_URL=postgresql://username:password@localhost:5432/involinks

# MySQL (alternative)
# DATABASE_URL=mysql://username:password@localhost:3306/involinks

# ==================== SUPER ADMIN ====================
# Default super admin credentials
# IMPORTANT: Change these in production!
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=ChangeThisPassword123!

# ==================== EMAIL SERVICE ====================
# Email service for MFA, password reset, notifications
# Currently using simulation - configure for production

# AWS SES
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# SES_FROM_EMAIL=noreply@yourdomain.com

# SMTP (alternative)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM_EMAIL=noreply@yourdomain.com

# ==================== PAYMENT PROCESSING ====================
# Stripe API keys
# Get from: https://dashboard.stripe.com/apikeys

# Development (test mode)
# STRIPE_SECRET_KEY=sk_test_your_test_key
# STRIPE_PUBLISHABLE_KEY=pk_test_your_test_key

# Production (live mode)
# STRIPE_SECRET_KEY=sk_live_your_live_key
# STRIPE_PUBLISHABLE_KEY=pk_live_your_live_key

# ==================== CRYPTOGRAPHIC SIGNING ====================
# For invoice signing and FTA compliance
# Generate using: python utils/generate_signing_keys.py

# SIGNING_PRIVATE_KEY_PEM=...
# SIGNING_CERTIFICATE_PEM=...
# SIGNING_CERT_SERIAL=...

# ==================== PEPPOL (Optional) ====================
# PEPPOL e-delivery network integration
# PEPPOL_PROVIDER_URL=https://your-peppol-provider.com/api
# PEPPOL_API_KEY=your-peppol-api-key
# PEPPOL_PARTICIPANT_ID=your-peppol-id

# ==================== FRONTEND ====================
# Vite environment variables (must start with VITE_)
VITE_API_URL=http://localhost:8000

# ==================== OPTIONAL ====================
# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO

# API rate limiting (requests per minute)
# RATE_LIMIT_LOGIN=5
# RATE_LIMIT_MFA=5
# RATE_LIMIT_PASSWORD_RESET=3

# Session timeout (minutes)
# SESSION_TIMEOUT=60

# File upload limits (MB)
# MAX_FILE_SIZE_MB=10
