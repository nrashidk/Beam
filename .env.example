# ==============================================
# UAE Digital Invoicing Platform - Environment Variables
# ==============================================
# This file shows all required environment variables for the application.
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control!

# ----------------------------------------------
# AWS SES Configuration (Email Service)
# ----------------------------------------------
# Used for: Email verification, invoice delivery, MFA codes, notifications
# Get these from: AWS Console > IAM > Users > Security Credentials
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1
SENDER_EMAIL=noreply@yourdomain.com

# ----------------------------------------------
# Stripe Payment Integration
# ----------------------------------------------
# Used for: Subscription payments, card processing, payment intents
# Get these from: Stripe Dashboard > Developers > API Keys
# Note: Use test keys (sk_test_/pk_test_) for development
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_publishable_key_here

# ----------------------------------------------
# Application Security
# ----------------------------------------------
# Used for: JWT token signing, session encryption
# Generate with: openssl rand -base64 32
SESSION_SECRET=your_random_session_secret_here_min_32_chars

# ----------------------------------------------
# Frontend Configuration
# ----------------------------------------------
# Used for: Frontend API communication
# For local dev: http://localhost:8000
# For production: https://your-api-domain.com
VITE_API_URL=http://localhost:8000

# ----------------------------------------------
# Database Configuration (Optional - for local PostgreSQL)
# ----------------------------------------------
# If running PostgreSQL locally instead of using Replit's database
# DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# ----------------------------------------------
# Twilio SMS Integration (Optional - Not yet configured)
# ----------------------------------------------
# Used for: SMS invoice delivery, MFA codes
# Get these from: Twilio Console > Account > Settings
# TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
# TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# TWILIO_PHONE_NUMBER=+1234567890

# ----------------------------------------------
# Additional Notes
# ----------------------------------------------
# 1. Create a .env file by copying this template: cp .env.example .env
# 2. Fill in all required values in your .env file
# 3. Never commit .env to Git (it's in .gitignore)
# 4. For production, use production credentials (not test keys)
# 5. Rotate SESSION_SECRET periodically for security
